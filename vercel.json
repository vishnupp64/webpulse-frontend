{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://webpulse-backend-3ty9.onrender.com/api/:path*" },
    { "source": "/((?!api|tracker\\.js).*)", "destination": "/index.html" }
  ]
}